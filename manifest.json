{
  "short_name": "Roadbook VE",
  "name": "Roadbook VE",
  "description": "Planificateur et suivi en direct des stations de recharge IRVE le long de votre trajet GPX.",
  "icons": [
    {
      "src": "icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": "./index.html",
  "background_color": "#0f172a",
